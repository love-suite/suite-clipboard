{
  "sourceLanguage": "en",
  "strings": {
    "%@   ⇧↩ Plain text   Space Preview   ⌘⌫ Delete   Drag out to a folder or an app": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@   ⇧↩ Texte brut   Espace Aperçu   ⌘⌫ Supprimer   Glisser vers un dossier ou une app"
          }
        }
      }
    },
    "↩ Copy": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ Copier"
          }
        }
      }
    },
    "↩ Paste": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "↩ Coller"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser"
          }
        }
      }
    },
    "Clear All": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout effacer"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presse-papiers"
          }
        }
      }
    },
    "Clipboard History": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique du presse-papiers"
          }
        }
      }
    },
    "Close the list when you click elsewhere": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer la liste en cliquant ailleurs"
          }
        }
      }
    },
    "Copied in %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié dans %@"
          }
        }
      }
    },
    "Copied on another device (iPhone, iPad or Mac), through iCloud's Universal Clipboard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copié sur un autre appareil (iPhone, iPad ou Mac) via le Presse-papiers universel d'iCloud"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier"
          }
        }
      }
    },
    "Copy as Plain Text": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier en texte brut"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer"
          }
        }
      }
    },
    "Delete every item": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer tous les éléments"
          }
        }
      }
    },
    "Holding ⌘V and pasting need Accessibility access. Until then, items are copied: press ⌘V.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir ⌘V et coller nécessitent l'accès à l'accessibilité. En attendant, les éléments sont copiés : appuyez sur ⌘V."
          }
        }
      }
    },
    "Keep the list open": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la liste ouverte"
          }
        }
      }
    },
    "Nothing copied yet.\nWhat you copy shows up here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de copié pour l'instant.\nCe que vous copiez apparaît ici."
          }
        }
      }
    },
    "Nothing matches “%@”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résultat pour « %@ »."
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller"
          }
        }
      }
    },
    "Paste as Plain Text": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller en texte brut"
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épingler"
          }
        }
      }
    },
    "Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        }
      }
    },
    "Show All": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout afficher"
          }
        }
      }
    },
    "Unpin": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désépingler"
          }
        }
      }
    },
    "iCloud": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud"
          }
        }
      }
    },
    "%@   ⇧↩ Plain text   Space Preview   ⌘1-9   ⌘⌫ Delete": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@   ⇧↩ Texte brut   Espace Aperçu   ⌘1-9   ⌘⌫ Supprimer"
